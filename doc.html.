<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GenDoc</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { background: #121212; color: white; font-family: sans-serif; padding: 16px; padding-bottom: 50px; }
        input, select { width: 100%; padding: 12px; margin-bottom: 10px; border-radius: 8px; border: 1px solid #333; background: #1e1e1e; color: white; box-sizing: border-box; }
        button { width: 100%; padding: 16px; border-radius: 12px; border: none; background: #ff2a75; color: white; font-weight: bold; font-size: 16px; cursor: pointer; margin-top: 10px; }
        .card { background: #1e1e1e; padding: 16px; border-radius: 12px; margin-bottom: 16px; }
        .row { display: flex; gap: 5px; margin-bottom: 5px; }
        .row input { margin-bottom: 0; }
        .row .name { flex: 2; }
        .row .qty { flex: 1; }
        .row .price { flex: 1; }
        .btn-del { background: #d32f2f; width: 40px; padding: 0; flex: 0; }
        .status { color: #bbff00; text-align: center; margin-bottom: 10px; }
    </style>
</head>
<body>
    <div class="status" id="loadStatus">Загрузка...</div>

    <h2>Профиль</h2>
    <div class="card">
        <input type="text" id="company" placeholder="Название" value="ООО Тест">
        <input type="text" id="inn" placeholder="ИНН" value="1234567890">
        <input type="text" id="address" placeholder="Адрес" value="г. Москва">
        <input type="text" id="contacts" placeholder="Контакты" value="+7 999 999-99-99">
        <button id="saveBtn" style="background: #444;">Сохранить профиль</button>
    </div>

    <h2>Документ</h2>
    <div class="card">
        <select id="template">
            <option value="kp">Коммерческое предложение</option>
            <option value="smeta">Смета</option>
            <option value="dogovor">Договор</option>
        </select>

        <div id="services">
            <div class="row">
                <input type="text" class="name" placeholder="Услуга" value="Тест">
                <input type="number" class="qty" placeholder="Кол-во" value="1">
                <input type="number" class="price" placeholder="Цена" value="10000">
                <button class="btn-del" onclick="this.parentElement.remove()">X</button>
            </div>
        </div>
        <button style="background: #444;" onclick="addRow()">+ Добавить услугу</button>

        <div id="fields-dogovor" style="display:none; margin-top: 10px;">
            <input type="text" id="dogovor_number" placeholder="Номер договора" value="15/26">
            <input type="text" id="dogovor_date" placeholder="Дата" value="12.11.2026">
            <input type="text" id="customer_name" placeholder="Заказчик" value="ООО Заказчик">
            <input type="text" id="customer_inn" placeholder="ИНН Заказчика" value="0987654321">
            <input type="text" id="customer_address" placeholder="Адрес Заказчика" value="г. Москва">
            <input type="text" id="director_name" placeholder="Директор" value="Иванов И.И.">
        </div>
        
        <div id="fields-smeta" style="display:none; margin-top: 10px;">
            <input type="text" id="smeta_number" placeholder="Номер договора" value="15/26">
            <input type="text" id="smeta_date" placeholder="Дата сметы" value="12.11.2026">
        </div>

        <button id="genBtn" onclick="generate()">Скачать PDF</button>
    </div>

    <script>
        const tg = window.Telegram.WebApp; tg.expand();
        const chatId = tg.initDataUnsafe?.user?.id;

        async function loadProfile() {
            if (!chatId) return;
            document.getElementById('loadStatus').textContent = "Загрузка профиля...";
            try {
                const res = await fetch(`https://genkart-app.onrender.com/get-profile?chat_id=${chatId}`);
                const data = await res.json();
                if (data.status === "ok") {
                    document.getElementById('company').value = data.company;
                    document.getElementById('inn').value = data.inn;
                    document.getElementById('address').value = data.address;
                    document.getElementById('contacts').value = data.contacts;
                }
                document.getElementById('loadStatus').textContent = "Профиль загружен";
            } catch (e) {
                document.getElementById('loadStatus').textContent = "Профиль не найден";
            }
        }
        loadProfile();

        document.getElementById('saveBtn').addEventListener('click', async () => {
            const btn = document.getElementById('saveBtn');
            btn.textContent = "Сохранение...";
            const fd = new FormData();
            fd.append('chat_id', chatId);
            fd.append('company', document.getElementById('company').value);
            fd.append('inn', document.getElementById('inn').value);
            fd.append('address', document.getElementById('address').value);
            fd.append('contacts', document.getElementById('contacts').value);
            try {
                const res = await fetch('https://genkart-app.onrender.com/save-profile', { method: 'POST', body: fd });
                if (res.ok) { btn.textContent = "Сохранено!"; setTimeout(() => btn.textContent = "Сохранить профиль", 2000); }
            } catch (e) { btn.textContent = "Ошибка"; }
        });

        document.getElementById('template').addEventListener('change', (e) => {
            document.getElementById('fields-dogovor').style.display = e.target.value === 'dogovor' ? 'block' : 'none';
            document.getElementById('fields-smeta').style.display = e.target.value === 'smeta' ? 'block' : 'none';
        });

        function addRow() {
            const div = document.createElement('div');
            div.className = 'row';
            div.innerHTML = `<input type="text" class="name" placeholder="Услуга"><input type="number" class="qty" placeholder="Кол-во" value="1"><input type="number" class="price" placeholder="Цена"><button class="btn-del" onclick="this.parentElement.remove()">X</button>`;
            document.getElementById('services').appendChild(div);
        }

        async function generate() {
            const btn = document.getElementById('genBtn');
            btn.textContent = "Генерация...";
            const rows = document.querySelectorAll('.row');
            const services = [];
            rows.forEach(r => {
                const name = r.querySelector('.name').value;
                const qty = r.querySelector('.qty').value;
                const price = r.querySelector('.price').value;
                if (name && price) services.push({ name, qty, price });
            });
            const fd = new FormData();
            fd.append('template', document.getElementById('template').value);
            fd.append('company', document.getElementById('company').value);
            fd.append('inn', document.getElementById('inn').value);
            fd.append('address', document.getElementById('address').value);
            fd.append('contacts', document.getElementById('contacts').value);
            fd.append('services_json', JSON.stringify(services));
            fd.append('term', '30');
            if (document.getElementById('fields-dogovor').style.display === 'block') {
                fd.append('dogovor_number', document.getElementById('dogovor_number').value);
                fd.append('dogovor_date', document.getElementById('dogovor_date').value);
                fd.append('customer_name', document.getElementById('customer_name').value);
                fd.append('customer_inn', document.getElementById('customer_inn').value);
                fd.append('customer_address', document.getElementById('customer_address').value);
                fd.append('director_name', document.getElementById('director_name').value);
            }
            if (document.getElementById('fields-smeta').style.display === 'block') {
                fd.append('dogovor_number', document.getElementById('smeta_number').value);
                fd.append('smeta_date', document.getElementById('smeta_date').value);
            }
            try {
                const res = await fetch('https://genkart-app.onrender.com/generate-doc', { method: 'POST', body: fd });
                if (res.ok) {
                    const blob = await res.blob();
                    tg.openLink(URL.createObjectURL(blob));
                } else { tg.showAlert("Ошибка сервера"); }
            } catch (e) { tg.showAlert("Ошибка сети"); }
            finally { btn.textContent = "Скачать PDF"; }
        }
    </script>
</body>
</html>
